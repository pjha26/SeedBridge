# Server environment variables
# Copy this file to .env and fill in the values before starting the server.
# Never commit the real .env file.

# MongoDB connection string
# Local: mongodb://localhost:27017/seedbridge
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/seedbridge
MONGO_URI=mongodb://localhost:27017/seedbridge

# Port the Express server listens on
PORT=5000

# JWT signing secret — must be at least 32 characters of random text
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# JWT token expiry (ms notation or string accepted by jsonwebtoken)
JWT_EXPIRES_IN=7d

# Origin the CORS policy and Socket.io allow — must match the client URL exactly
CLIENT_URL=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Auth rate limiter — optional; defaults shown
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP (default: 10)
RATE_LIMIT_MAX=10
